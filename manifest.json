{
    "manifest_version": 3,
    "name": "exp-cloudlab",
    "version": "2.0.0",
    "description": "Add calendar reminder to CloudLab experiments",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "192": "icons/icon192.png"
    },
    "options_page": "src/options/options.html",
    "permissions": ["storage"],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon32.png",
            "128": "icons/icon192.png"
        },
        "default_title": "exp-cloudlab"
    },
    "content_scripts": [
        {
            "matches": ["https://www.cloudlab.us/*"],
            "js": [
                "src/utils/dateUtils.js",
                "src/utils/domUtils.js",
                "src/services/storageService.js",
                "src/services/calendarService.js",
                "src/components/reminderButton.js",
                "content.js"
            ],
            "run_at": "document_end"
        }
    ]
}
